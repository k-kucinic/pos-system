<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" fillWidth="false" maxWidth="1000.0" prefWidth="1000.0" spacing="20.0" stylesheets="@all-products.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.tvz.possystem.controllers.admin.products.AllProductsController">
    <children>
      <VBox prefHeight="71.0" prefWidth="1000.0">
         <children>
            <Label text="SVI PROIZVODI">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </Label>
            <HBox alignment="CENTER_LEFT" prefHeight="46.0" prefWidth="1014.0">
               <children>
                  <Label prefHeight="20.0" prefWidth="278.0" text="Za uređivanje proizvoda pritisnite desni klik">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" prefHeight="26.0" prefWidth="1022.0" spacing="10.0">
         <children>
            <TextField fx:id="searchTextField" onAction="#searchByNameOrId" prefHeight="26.0" prefWidth="179.0" promptText="barkod ili naziv" />
            <Button mnemonicParsing="false" onAction="#searchByNameOrId" styleClass="search-button" text="Traži" />
         </children>
      </HBox>
        <TableView fx:id="productTableView" maxWidth="1000.0" minWidth="900.0" prefWidth="1000.0" VBox.vgrow="NEVER">
            <columns>
                <TableColumn fx:id="idTableColumn" prefWidth="54.399993896484375" text="ID" />
                <TableColumn fx:id="nameTableColumn" minWidth="0.0" prefWidth="112.0000228881836" text="NAZIV" />
                <TableColumn fx:id="barcodeTableColumn" minWidth="0.0" prefWidth="195.99998474121094" text="BAR-KOD" />
                <TableColumn fx:id="categoryTableColumn" minWidth="0.0" prefWidth="116.0" text="KATEGORIJA" />
                <TableColumn fx:id="taxRateTableColumn" minWidth="0.0" prefWidth="116.79998779296875" text="PDV" />
                <TableColumn fx:id="priceTableColumn" minWidth="0.0" prefWidth="91.20001220703125" text="CIJENA" />
                <TableColumn fx:id="stockQuantityTableColumn" prefWidth="100.80001831054688" text="SKLADIŠTE" />
                <TableColumn fx:id="discountTableColumn" prefWidth="56.79998779296875" text="POPUST" />
                <TableColumn fx:id="isActiveTableColumn" prefWidth="68.79998779296875" text="AKTIVAN" />
                <TableColumn fx:id="createdAtTableColumn" prefWidth="117.60009765625" text="KREIRANO" />
                <TableColumn fx:id="updatedAtTableColumn" prefWidth="147.9998779296875" text="IZMJENJENO" />
            </columns>
            <contextMenu>
                <ContextMenu fx:id="contextMenu">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#setInactive" text="Ukloni" />
                        <MenuItem mnemonicParsing="false" onAction="#edit" text="Uredi" />
                        <MenuItem mnemonicParsing="false" onAction="#addStockQuantity" text="Dodavanje zalihe " />
                    </items>
                </ContextMenu>
            </contextMenu>
        </TableView>
    </children>
   <padding>
      <Insets left="20.0" right="20.0" />
   </padding>
</VBox>
