<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
          prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="hr.tvz.possystem.controllers.admin.products.EditPopUPController" stylesheets="@product-style.css">
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
    </rowConstraints>
    <children>
        <Label text="Uređivanje proizvoda">
            <padding>
                <Insets left="10.0"/>
            </padding>
        </Label>
        <Label text="Naziv:" GridPane.rowIndex="1">
            <padding>
                <Insets left="10.0"/>
            </padding>
        </Label>
        <TextField fx:id="nameTextField" GridPane.columnSpan="2" GridPane.rowIndex="2">
            <GridPane.margin>
                <Insets left="10.0"/>
            </GridPane.margin>
        </TextField>
        <Label text="Cijena" GridPane.halignment="RIGHT" GridPane.rowIndex="4">
            <padding>
                <Insets left="10.0"/>
            </padding>
            <GridPane.margin>
                <Insets right="10.0"/>
            </GridPane.margin>
        </Label>
        <Label text="Popust" GridPane.halignment="RIGHT" GridPane.rowIndex="6">
            <padding>
                <Insets left="10.0"/>
            </padding>
            <GridPane.margin>
                <Insets right="10.0"/>
            </GridPane.margin>
        </Label>
        <Button cancelButton="true" mnemonicParsing="false" text="Odustani" textAlignment="CENTER"
                GridPane.halignment="RIGHT" GridPane.rowIndex="7" GridPane.valignment="CENTER" styleClass="button-cancel" onAction="#cancel">
            <GridPane.margin>
                <Insets right="15.0"/>
            </GridPane.margin>
        </Button>
        <Button defaultButton="true" mnemonicParsing="false" text="Spremi" textAlignment="CENTER"
                GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="7" GridPane.valignment="CENTER"
                onAction="#save">
            <GridPane.margin>
                <Insets left="15.0"/>
            </GridPane.margin>
        </Button>
        <TextField fx:id="priceTextField" maxWidth="-Infinity" prefWidth="300.0" GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>
        <TextField fx:id="discountTextField" maxWidth="-Infinity" prefWidth="300.0" GridPane.columnIndex="1"
                   GridPane.rowIndex="6"/>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="20.0"/>
    </padding>
</GridPane>
