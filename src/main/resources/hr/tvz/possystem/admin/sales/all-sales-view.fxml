<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="Infinity" maxWidth="Infinity" minWidth="600" prefHeight="400.0" spacing="10.0" stylesheets="@all-sales.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.tvz.possystem.controllers.admin.sales.AllSalesController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="40.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Datum od:" />
                        <DatePicker fx:id="dateTimeFrom" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Datum do:" />
                        <DatePicker fx:id="dateTimeTo" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="30.0">
            <children>
                <Button defaultButton="true" mnemonicParsing="false" onAction="#search" styleClass="search-button" text="Pretraga" />
                <Button fx:id="showAllSalesButton" cancelButton="true" mnemonicParsing="false" onAction="#showAllSales" styleClass="cancel-filter-button" text="Prikaži sve" visible="false" />
            </children>
        </HBox>
        <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox alignment="CENTER" spacing="20.0" HBox.hgrow="NEVER">
                    <children>
                        <TableView fx:id="salesTableView" maxWidth="Infinity" prefHeight="200.0" prefWidth="800.0">
                            <columns>
                                <TableColumn fx:id="idTableColumn" prefWidth="47.20000684261322" text="ID" />
                                <TableColumn fx:id="dateTableColumn" prefWidth="122.40003204345703" text="datum" />
                                <TableColumn fx:id="timeTableColumn" prefWidth="82.40003967285156" text="vrijeme" />
                                <TableColumn fx:id="totalAmountTableColumn" prefWidth="113.5999755859375" text="ukupno" />
                                <TableColumn fx:id="userTableColumn" prefWidth="135.99990844726562" text="blagajnik" />
                                <TableColumn fx:id="notesTableColumn" prefWidth="196.79998779296875" text="bilješke" />
                                <TableColumn fx:id="refundedTableColumn" prefWidth="76.7999267578125" text="vraćeno" />

                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <TableView fx:id="saleItemsTableView" maxWidth="-Infinity" prefHeight="200.0" prefWidth="600.0" visible="false">
                            <columns>
                                <TableColumn fx:id="saleItemIdTableColumn" prefWidth="40.800058007240295" text="ID" />
                                <TableColumn fx:id="barcodeSaleItemTableView" prefWidth="125.60002899169922" text="bar-kod" />
                                <TableColumn fx:id="saleItemProductColumn" prefWidth="108.0" text="proizvod" />
                                <TableColumn fx:id="quantityTableColumn" prefWidth="62.39996337890625" text="količina" />
                                <TableColumn fx:id="unitPriceTableColumn" prefWidth="53.600006103515625" text="cijena" />
                                <TableColumn fx:id="totalPriceSaleItemColumn" prefWidth="69.59994506835938" text="ukupno" />
                                <TableColumn fx:id="isSaleItemRefundedTableColumn" prefWidth="58.399932861328125" text="vraćeno" />
                                <TableColumn fx:id="taxRateTableColumn" prefWidth="72.7999267578125" text="pdv" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="29.0" HBox.hgrow="NEVER">
                    <children>
                        <Button mnemonicParsing="false" onAction="#showSaleItems" styleClass="show-button" text="Prikaz artikala" />
                        <Button fx:id="printTheReceiptButton" mnemonicParsing="false" onAction="#printTheReceipt" styleClass="show-button" text="Ispis računa" visible="false" />
                        <Button fx:id="close" cancelButton="true" mnemonicParsing="false" onAction="#hide" styleClass="cancel-button" text="Zatvori" visible="false" />
                    </children>
                    <padding>
                        <Insets right="20.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>
