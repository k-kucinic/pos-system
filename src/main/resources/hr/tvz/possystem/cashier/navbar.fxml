<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane id="root" fx:id="anchorPane" maxWidth="Infinity" prefHeight="35.0" styleClass="root" stylesheets="@navbar.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.tvz.possystem.controllers.NavbarController">
   <children>
      <HBox alignment="CENTER" prefHeight="35.0" spacing="40.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="5.0" left="30.0" right="30.0" top="5.0" />
         </padding>
         <children>
            <Label fx:id="newScreenLabel" accessibleRole="BUTTON" onMouseClicked="#openNewScreen" text="Label" HBox.hgrow="ALWAYS">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Label>
            <Label fx:id="adminLabel" text="Admin" accessibleRole="BUTTON" onMouseClicked="#openCashierScreen" />
            <HBox alignment="CENTER_RIGHT" prefHeight="35.0" prefWidth="312.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="usernameLabel" text="Label" />
                  <Button mnemonicParsing="false" onAction="#logOut" text="Odjava" />
               </children>
               <padding>
                  <Insets right="10.0" />
               </padding>
            </HBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
